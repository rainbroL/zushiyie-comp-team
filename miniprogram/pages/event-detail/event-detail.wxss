/* pages/event-detail/event-detail.wxss */
.page {
  min-height: 100vh;
  background: #f5f6fa;
}

.content-wrapper {
  padding: 30rpx;
  padding-bottom: 160rpx;
}

.detail-header {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.detail-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #2d3436;
  display: block;
  margin-bottom: 16rpx;
}

.detail-status {
  font-size: 26rpx;
  color: #e17055;
  background: #fde8e4;
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  display: inline-block;
}

.detail-body {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  min-height: 300rpx;
}

.detail-desc {
  font-size: 30rpx;
  color: #2d3436;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* ===== 固定底部按钮 ===== */
.fixed-btn {
  position: fixed;
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  width: calc(100% - 80rpx);
  max-width: 600rpx;
  background: #e17055;
  border-radius: 60rpx;
  padding: 28rpx 0;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(225, 112, 85, 0.4);
  z-index: 100;
}

.btn-text {
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
}

.fixed-btn:active {
  transform: translateX(-50%) scale(0.95);
  opacity: 0.9;
}

.empty {
  text-align: center;
  padding: 200rpx 0;
  color: #b2bec3;
  font-size: 30rpx;
}
/* 图片样式 */
.image-wrapper {
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #f5f6fa;
}

.event-image {
  width: 100%;
  height: 400rpx;
  display: block;
}