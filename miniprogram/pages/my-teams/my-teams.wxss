/* pages/my-teams/my-teams.wxss */
.page {
  min-height: 100vh;
  background: #f5f6fa;
  padding: 30rpx;
  padding-bottom: 60rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #636e72;
  margin: 20rpx 8rpx 20rpx;
}

.section-title:first-child {
  margin-top: 8rpx;
}

.team-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.team-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.team-card:active {
  transform: scale(0.99);
  opacity: 0.92;
}

.team-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.team-number {
  font-size: 24rpx;
  color: #6c5ce7;
  background: #eee9ff;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.team-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #2d3436;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.team-status {
  font-size: 22rpx;
  color: #00b894;
  background: #e0f7f0;
  padding: 4rpx 16rpx;
  border-radius: 30rpx;
  /* 不让它被队名挤压：压窄后文字会溢出背景，看起来就不居中了 */
  flex-shrink: 0;
  white-space: nowrap;
  line-height: 1.4;
  text-align: center;
}

.team-status.full {
  color: #e17055;
  background: #fde8e4;
}

.team-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #b2bec3;
}

.team-desc {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f0f0f0;
  font-size: 25rpx;
  color: #636e72;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.empty {
  text-align: center;
  padding: 160rpx 0;
  color: #b2bec3;
  font-size: 30rpx;
}

.empty-icon {
  font-size: 88rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-hint {
  display: block;
  font-size: 26rpx;
  color: #dfe6e9;
  margin-top: 12rpx;
}

.empty-btn {
  display: inline-block;
  margin-top: 40rpx;
  padding: 20rpx 60rpx;
  background: #6c5ce7;
  color: #fff;
  font-size: 28rpx;
  border-radius: 50rpx;
}

.empty-btn:active {
  opacity: 0.85;
}

.loading {
  text-align: center;
  padding: 160rpx 0;
  color: #b2bec3;
  font-size: 28rpx;
}
