/* pages/team-create/team-create.wxss */
.page {
  min-height: 100vh;
  background: #f5f6fa;
  padding: 30rpx;
}

.form-header {
  padding: 20rpx 10rpx 30rpx;
}

.form-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #2d3436;
  display: block;
}

.form-subtitle {
  font-size: 28rpx;
  color: #b2bec3;
  margin-top: 8rpx;
  display: block;
}

.form {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.form-item {
  margin-bottom: 36rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 30rpx;
  font-weight: 500;
  color: #2d3436;
  display: block;
  margin-bottom: 12rpx;
}

.required {
  color: #e17055;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #dfe6e9;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #6c5ce7;
}

.picker-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.picker-display {
  flex: 1;
  height: 80rpx;
  border: 2rpx solid #dfe6e9;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #2d3436;
  display: flex;
  align-items: center;
  background: #fff;
}

.picker-hint {
  font-size: 28rpx;
  color: #b2bec3;
}

.form-hint {
  font-size: 24rpx;
  color: #b2bec3;
  margin-top: 8rpx;
  display: block;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  border: 2rpx solid #dfe6e9;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

.form-textarea:focus {
  border-color: #6c5ce7;
}

.char-count {
  font-size: 24rpx;
  color: #b2bec3;
  text-align: right;
  display: block;
  margin-top: 8rpx;
}

.submit-btn {
  background: #6c5ce7;
  color: #fff;
  text-align: center;
  padding: 28rpx;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: bold;
  margin-top: 30rpx;
  transition: all 0.2s;
}

.submit-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}