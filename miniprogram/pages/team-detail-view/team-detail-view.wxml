<!-- pages/team-detail-view/team-detail-view.wxml -->
<view class="page" wx:if="{{team}}">

  <!-- 队伍名称 -->
  <view class="card">
    <view class="team-name">{{team.teamName}}</view>
    <view class="team-status {{team.isFull ? 'full' : 'recruiting'}}">{{team.isFull ? '已满' : '招募中'}}</view>
    <view class="team-number" wx:if="{{hasTeamNumber}}">
      #{{team.teamNumber}} 号队伍
    </view>
  </view>

  <!-- 我的申请状态（队长和已加入的人不需要看） -->
  <view class="status-card {{myStatus}}" wx:if="{{!isLeader && myStatus !== 'none'}}">
    <text class="status-text">{{statusTip}}</text>
    <view class="status-action" wx:if="{{myStatus === 'pending'}}" bindtap="onCancelApply">撤回申请</view>
    <view class="status-action danger" wx:if="{{myStatus === 'approved'}}" bindtap="onQuitTeam">退出队伍</view>
  </view>

  <!-- 队伍描述 -->
  <view class="card">
    <view class="section-title">📋 队伍描述</view>
    <view class="section-content">{{team.description}}</view>
  </view>

  <!-- 成员列表 -->
  <view class="card">
    <view class="section-title">👥 成员列表（{{memberCount}}/{{team.maxSize}}人）</view>
    <view class="member-list">
      <view class="member-item" wx:for="{{team.members}}" wx:key="openid">
        <view class="member-avatar">{{item.avatar || '👤'}}</view>
        <view class="member-info">
          <view class="member-name-row">
            <text class="member-name">{{item.name}}</text>
            <text class="member-role" wx:if="{{item.isLeader}}">队长</text>
            <text class="member-grade" wx:if="{{item.grade}}">{{item.grade}}</text>
          </view>
          <text class="member-desc" wx:if="{{item.desc}}">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 队长视角：待处理申请 -->
  <view class="card" wx:if="{{isLeader}}">
    <view class="section-title">📥 待处理申请（{{applications.length}}）</view>

    <view class="empty-tip" wx:if="{{applications.length === 0}}">
      还没有人申请。把队伍编号发给同学，他们就能在队伍列表里找到你。
    </view>

    <view class="application-list">
      <view class="application-item" wx:for="{{applications}}" wx:key="_id">
        <view class="member-item">
          <view class="member-avatar">{{item.applicant.avatar || '👤'}}</view>
          <view class="member-info">
            <view class="member-name-row">
              <text class="member-name">{{item.applicant.name}}</text>
              <text class="member-grade" wx:if="{{item.applicant.grade}}">{{item.applicant.grade}}</text>
            </view>
            <text class="member-desc" wx:if="{{item.applicant.desc}}">{{item.applicant.desc}}</text>
            <view class="application-message" wx:if="{{item.message}}">
              留言：{{item.message}}
            </view>
          </view>
        </view>

        <view class="application-actions">
          <view
            class="action-btn reject {{handlingId === item._id ? 'loading' : ''}}"
            data-id="{{item._id}}"
            bindtap="onReject"
          >拒绝</view>
          <view
            class="action-btn approve {{handlingId === item._id ? 'loading' : ''}}"
            data-id="{{item._id}}"
            bindtap="onApprove"
          >同意</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 队长联系方式：只有队长和已加入的成员能看到内容 -->
  <view class="card">
    <view class="section-title">📞 队长联系方式</view>
    <block wx:if="{{canSeeContact && contact}}">
      <view class="section-content contact-text" bindtap="onCopyContact">{{contact}}</view>
      <text class="copy-hint">点击可复制</text>
    </block>
    <view class="contact-locked" wx:else>
      <text class="lock-icon">🔒</text>
      <text class="lock-text">{{contactHint}}</text>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-btn-wrapper">
    <view
      class="apply-btn {{btnDisabled ? 'disabled' : ''}}"
      bindtap="onApply"
    >{{btnText}}</view>
  </view>

</view>

<view class="loading" wx:else>
  <text>加载中...</text>
</view>
