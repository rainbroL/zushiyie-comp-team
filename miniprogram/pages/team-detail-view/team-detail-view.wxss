/* pages/team-detail-view/team-detail-view.wxss */
.page {
  min-height: 100vh;
  background: #f5f6fa;
  padding: 30rpx;
  padding-bottom: 160rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.team-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #2d3436;
  display: inline-block;
  vertical-align: middle;
}

.team-status {
  display: inline-block;
  font-size: 24rpx;
  padding: 4rpx 20rpx;
  border-radius: 30rpx;
  margin-left: 16rpx;
  vertical-align: middle;
}

.team-status.recruiting {
  color: #00b894;
  background: #e0f7f0;
}

.team-status.full {
  color: #e17055;
  background: #fde8e4;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2d3436;
  margin-bottom: 16rpx;
}

.section-content {
  font-size: 28rpx;
  color: #636e72;
  line-height: 1.8;
  white-space: pre-wrap;
}

.member-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.member-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.member-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.member-avatar {
  font-size: 44rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #dfe6e9;
  border-radius: 50%;
  flex-shrink: 0;
}

.member-info {
  flex: 1;
  min-width: 0;
}

.member-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-bottom: 4rpx;
}

.member-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #2d3436;
}

.member-grade {
  font-size: 20rpx;
  color: #6c5ce7;
  background: #eee9ff;
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
}

.member-role {
  font-size: 20rpx;
  color: #fff;
  background: #6c5ce7;
  padding: 2rpx 14rpx;
  border-radius: 4rpx;
}

.member-desc {
  font-size: 24rpx;
  color: #b2bec3;
  display: block;
  line-height: 1.4;
}

.bottom-btn-wrapper {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06);
}

.apply-btn {
  background: #6c5ce7;
  color: #fff;
  text-align: center;
  padding: 28rpx;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: bold;
}

.apply-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.apply-btn.disabled {
  background: #b2bec3;
  pointer-events: none;
}

.loading {
  text-align: center;
  padding: 200rpx 0;
  color: #b2bec3;
  font-size: 30rpx;
}

/* ===== 队伍编号 ===== */
.team-number {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #b2bec3;
}

/* ===== 我的申请状态条 ===== */
.status-card {
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.status-card.pending {
  background: #fff6e5;
  color: #b07d16;
}

.status-card.approved {
  background: #e0f7f0;
  color: #00896b;
}

.status-card.rejected {
  background: #fde8e4;
  color: #c0503a;
}

.status-card.cancelled {
  background: #f0f1f5;
  color: #7a8390;
}

.status-text {
  display: block;
}

.status-action {
  display: inline-block;
  margin-top: 16rpx;
  padding: 10rpx 30rpx;
  font-size: 25rpx;
  color: #6c5ce7;
  background: #fff;
  border-radius: 30rpx;
}

.status-action:active {
  opacity: 0.7;
}

/* ===== 队长审核区 ===== */
.empty-tip {
  font-size: 25rpx;
  color: #b2bec3;
  line-height: 1.7;
}

.application-list {
  display: flex;
  flex-direction: column;
}

.application-item {
  padding-top: 24rpx;
  margin-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.application-item:first-child {
  padding-top: 0;
  margin-top: 0;
  border-top: none;
}

.application-item .member-item {
  border-bottom: none;
  padding-bottom: 0;
}

.application-message {
  margin-top: 10rpx;
  padding: 14rpx 18rpx;
  background: #f7f6ff;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #5b5178;
  line-height: 1.5;
}

.application-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 20rpx;
}

.action-btn {
  min-width: 150rpx;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 40rpx;
  font-size: 27rpx;
}

.action-btn:active {
  opacity: 0.8;
}

.action-btn.reject {
  color: #e17055;
  background: #fde8e4;
}

.action-btn.approve {
  color: #fff;
  background: #00b894;
}

.action-btn.loading {
  opacity: 0.5;
  pointer-events: none;
}

/* ===== 联系方式 ===== */
.contact-text {
  display: inline-block;
  color: #6c5ce7;
  word-break: break-all;
}

.copy-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #b2bec3;
}

/* 非成员看到的占位提示：不用灰色小字，避免被当成「加载失败」 */
.contact-locked {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #f7f6ff;
  border-radius: 12rpx;
}

.lock-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}

.lock-text {
  font-size: 26rpx;
  color: #8b87a8;
  line-height: 1.6;
}