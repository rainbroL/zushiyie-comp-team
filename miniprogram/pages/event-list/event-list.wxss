/* pages/event-list/event-list.wxss */
.page {
  min-height: 100vh;
  background: #f5f6fa;
  padding: 30rpx;
}

.page-header {
  padding: 20rpx 10rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #2d3436;
}

.page-count {
  font-size: 26rpx;
  color: #b2bec3;
}

.event-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.event-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  transition: all 0.2s;
}

.event-card:active {
  transform: scale(0.98);
  background: #f8f9fa;
}

.event-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #2d3436;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.event-desc-preview {
  font-size: 28rpx;
  color: #636e72;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.event-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.event-tags {
  display: flex;
  gap: 16rpx;
}

.tag {
  font-size: 24rpx;
  color: #b2bec3;
  background: #f5f6fa;
  padding: 6rpx 20rpx;
  border-radius: 8rpx;
}

.tag.team-tag {
  color: #e17055;
  background: #fde8e4;
}

.empty {
  text-align: center;
  padding: 160rpx 0;
  color: #b2bec3;
  font-size: 30rpx;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

/* ===== 分页状态 ===== */
.list-footer {
  text-align: center;
  padding: 40rpx 0 60rpx;
}

.footer-text {
  font-size: 25rpx;
  color: #b2bec3;
}

.footer-tap {
  color: #6c5ce7;
}