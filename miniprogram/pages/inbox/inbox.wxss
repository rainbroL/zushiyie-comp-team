/* pages/inbox/inbox.wxss */
.page {
  min-height: 100vh;
  background: #f5f6fa;
  padding: 24rpx 30rpx 60rpx;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 8rpx 20rpx;
}

.topbar-text {
  font-size: 26rpx;
  color: #636e72;
}

.topbar-action {
  font-size: 26rpx;
  color: #667eea;
}

.msg-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

/* 未读区与「更早」区之间的分隔：细线夹字。
   有已读就画，不和「上方是否有未读」挂钩，两段的分界始终明确 */
.divider {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 30rpx 6rpx 18rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #e2e5ef;
}

.divider-text {
  font-size: 22rpx;
  color: #9aa4b8;
  letter-spacing: 2rpx;
}

.msg-card {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  /* 左边条始终占位（透明），未读时只换颜色。
     否则已读/未读之间卡片宽度会差 6rpx，列表看起来会抖一下 */
  border-left: 6rpx solid transparent;
  box-sizing: border-box;
  padding: 26rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  transition: background-color 0.2s;
}

.msg-card:active {
  transform: scale(0.99);
  opacity: 0.92;
}

/* ===== 未读：色条 + 淡底 + 浮起阴影，三处同时变化 ===== */
.msg-card.unread {
  background: #f4f6ff;
  border-left-color: #667eea;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.16);
}

.msg-icon {
  width: 68rpx;
  height: 68rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #f1f2f6;
  font-size: 34rpx;
  line-height: 68rpx;
  text-align: center;
}

.msg-card.unread .msg-icon {
  background: #e3e8ff;
}

.msg-main {
  flex: 1;
  min-width: 0;
}

.msg-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

/* 已读：灰字常规字重；未读：深色加粗。这一档最关键——
   底色差异再小，字重和颜色一眼就能分辨 */
.msg-title {
  font-size: 30rpx;
  font-weight: normal;
  color: #8d99ae;
}

.msg-card.unread .msg-title {
  font-weight: bold;
  color: #1b2559;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff4757;
  flex-shrink: 0;
}

.msg-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #a4adbe;
}

.msg-card.unread .msg-desc {
  color: #5b6478;
}

.msg-time {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #c3c9d6;
}

.msg-card.unread .msg-time {
  color: #7b87a8;
}

.msg-arrow {
  align-self: center;
  font-size: 36rpx;
  color: #b2bec3;
}

.msg-card.unread .msg-arrow {
  color: #667eea;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 180rpx;
}

.empty-icon {
  font-size: 90rpx;
  opacity: 0.45;
}

.empty-text {
  margin-top: 26rpx;
  font-size: 30rpx;
  color: #636e72;
}

.empty-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #b2bec3;
}

.loading,
.failed {
  text-align: center;
  padding-top: 60rpx;
  font-size: 26rpx;
  color: #b2bec3;
}
